# Copy this file to .env and fill in your values
# cp .env.example .env

# Optional: shared secret between Cloud Connector and this server
# Set the same value as the Authorization header in your Cloud Connector rule:
#   Headers → Authorization: Bearer <your-secret>
WEBHOOK_SECRET=

# Maximum number of events to keep in memory (older ones are dropped)
MAX_EVENTS=1000

# Host ports (change if something is already running on these)
FRONTEND_PORT=8080
BACKEND_PORT=3001
